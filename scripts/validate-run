#!/usr/bin/env python3
"""Validate a clean Git commit with ordered steps and bounded infrastructure recovery."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--job', required=True, type=Path)
    parser.add_argument('--output', required=True, type=Path)
    parser.add_argument('--reuse-build', type=Path)
    args = parser.parse_args()
    job = json.loads(args.job.read_text())
    worktree = Path(job['worktree']).resolve()
    output = args.output.resolve()
    if output == worktree or worktree in output.parents:
        parser.error('output must be outside the validation worktree')
    stages = ('build', 'verify', 'health', 'smoke', 'test', 'collect', 'recover')
    for name in stages:
        if name in job and (not isinstance(job[name], list) or not job[name]
                            or not all(isinstance(x, str) for x in job[name])):
            parser.error(f'{name} must be a nonempty argv array')
    if 'smoke' not in job or 'test' not in job:
        parser.error('smoke and test commands are required')
    if ('build' in job or args.reuse_build) and 'verify' not in job:
        parser.error('build/reuse requires an installed-artifact verification command')
    environment = job.get('environment', {})
    if not isinstance(environment, dict) or not all(isinstance(k, str) and isinstance(v, str)
                                                    for k, v in environment.items()):
        parser.error('environment must map names to strings')
    timeout = job.get('step_timeout', 1800)
    if not isinstance(timeout, (int, float)) or timeout <= 0:
        parser.error('step_timeout must be positive')
    output.mkdir(parents=True, exist_ok=False)
    env = dict(os.environ, **environment)
    evidence = {'status': 'running', 'steps': [], 'worktree': str(worktree)}

    def git(*argv):
        return subprocess.check_output(['git', '-C', str(worktree), *argv], text=True).strip()

    commit = git('rev-parse', 'HEAD')
    evidence['commit'] = commit
    evidence['configuration_sha256'] = hashlib.sha256(
        json.dumps(environment, sort_keys=True).encode()).hexdigest()
    fingerprint = hashlib.sha256(json.dumps({
        'commit': commit, 'build': job.get('build'), 'verify': job.get('verify'),
        'environment': environment,
    }, sort_keys=True).encode()).hexdigest()
    evidence['build_fingerprint'] = fingerprint
    sequence = 0

    def save():
        (output / 'result.json').write_text(json.dumps(evidence, indent=2) + '\n')

    def frozen():
        if git('rev-parse', 'HEAD') != commit or git('status', '--porcelain', '--untracked-files=normal'):
            raise RuntimeError('validation source changed or is dirty; evidence is invalid')

    def run(name):
        nonlocal sequence
        if name not in job:
            return 0
        frozen()
        sequence += 1
        log = output / f'{sequence:02d}-{name}.log'
        start = time.monotonic()
        with log.open('w') as stream:
            try:
                code = subprocess.run(job[name], cwd=worktree, env=env,
                                      stdout=stream, stderr=subprocess.STDOUT,
                                      timeout=timeout).returncode
            except subprocess.TimeoutExpired:
                code = 124
            except OSError as error:
                stream.write(str(error) + '\n')
                code = 127
        evidence['steps'].append({'stage': name, 'exit_code': code,
                                  'seconds': round(time.monotonic() - start, 3),
                                  'log': str(log)})
        save()
        frozen()
        return code

    def finish(status, code):
        evidence['status'] = status
        save()
        print(json.dumps({'status': status, 'evidence': str(output / 'result.json')}))
        return code

    try:
        frozen()
        if job.get('commit', commit) != commit:
            raise RuntimeError('HEAD does not match the requested commit')
        if args.reuse_build:
            receipt = json.loads(args.reuse_build.read_text())
            if receipt.get('build_fingerprint') != fingerprint or not receipt.get('build_verified'):
                raise RuntimeError('build receipt does not match this source and configuration')
        elif run('build'):
            run('collect')
            return finish('build-failed', 1)
        if run('verify'):
            run('collect')
            return finish('artifact-verification-failed', 1)
        if 'verify' in job:
            evidence['build_verified'] = True
            save()
        recovered = False
        while True:
            infrastructure_failed = bool(run('health'))
            failed = infrastructure_failed
            if not failed:
                failed = bool(run('smoke'))
                infrastructure_failed = bool(run('health'))
                failed = failed or infrastructure_failed
            if not failed:
                failed = bool(run('test'))
                infrastructure_failed = bool(run('health'))
                failed = failed or infrastructure_failed
            if not failed:
                return finish('passed', 0)
            run('collect')
            if not infrastructure_failed:
                return finish('test-failed', 1)
            if recovered or 'recover' not in job:
                return finish('infrastructure-failed', 2)
            recovered = True
            if run('recover') or run('verify'):
                return finish('infrastructure-failed', 2)
            # Recovery always re-enters through health and the smoke flow.
    except (RuntimeError, subprocess.CalledProcessError) as error:
        evidence['error'] = str(error)
        return finish('invalid-evidence', 3)


if __name__ == '__main__':
    sys.exit(main())
