#!/usr/bin/env python3
"""Cache preflight, launcher, and durable controller regression tests."""
import json
import os
from pathlib import Path
import shutil
import signal
import time
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent


class StoreTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix='fanout-store-test-')
        self.addCleanup(self.tmp.cleanup)
        self.base = Path(self.tmp.name).resolve()
        self.repo = self.base / 'repo'
        self.repo.mkdir()
        self.store = self.base / 'shared store'
        (self.store / 'v11').mkdir(parents=True)
        self.bin = self.base / 'bin'
        self.bin.mkdir()
        self.env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ['PATH'],
                        CODEX_HOME=str(self.base / 'codex-home'),
                        AGENT_FANOUT_STATE_HOME=str(self.base / 'state'),
                        CAPTURE=str(self.base / 'capture.json'), BASH_ENV='/dev/null',
                        ENV='/dev/null', SHELL='/bin/bash')
        self.call(['git', 'init', '-q'])
        self.call(['git', 'config', 'user.name', 'Store Test'])
        self.call(['git', 'config', 'user.email', 'test@example.invalid'])
        (self.repo / 'file').write_text('base\n')
        self.call(['git', 'add', 'file'])
        self.call(['git', 'commit', '-qm', 'base'])
        self.brief = self.base / 'brief'
        self.brief.write_text('test only')
        self.fake('pnpm', '''import os,pathlib
key='npm_config_store_dir' if os.environ.get('LEGACY_PNPM') else 'pnpm_config_store_dir'
p=pathlib.Path(os.environ.get(key, '/wrong-store'))
if os.environ.get('WRONG_STORE'): p=pathlib.Path('/wrong-store')
print(p if p.name == 'v11' else p/'v11')
''')
        self.fake('codex', '''import json,os,subprocess,sys
args=sys.argv[1:]
if args[:2] == ['sandbox','--help']:
 print('Commands: macos linux' if os.environ.get('OLD_CODEX_SANDBOX') else 'Run commands in a sandbox');sys.exit(0)
if args[0] == 'sandbox':
 if os.environ.get('OLD_CODEX_SANDBOX'): assert args[1] in ['macos','linux','windows']
 if os.environ.get('PROBE_PID'):
  import time
  open(os.environ['PROBE_PID'],'w').write(str(os.getpid()))
  time.sleep(120)
 if os.environ.get('DENY_STORE'):
  print('store denied by sandbox',file=sys.stderr);sys.exit(2)
 sys.exit(subprocess.call(args[args.index('--')+1:]))
assert args[0] == 'exec', args
json.dump({'args':args,'store':os.environ.get('pnpm_config_store_dir')},open(os.environ['CAPTURE'],'w'))
print('{"type":"turn.completed"}')
''')

    def fake(self, name, source):
        p = self.bin / name
        p.write_text('#!/usr/bin/env python3\n' + source)
        p.chmod(0o755)

    def call(self, args, ok=True, **kwargs):
        result = subprocess.run([str(a) for a in args], cwd=self.repo, env=self.env,
                                text=True, capture_output=True, timeout=75, **kwargs)
        if ok:
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        return result

    def launcher_args(self, store=None):
        args = [ROOT / 'launch-codex-lane', '--worktree', self.repo,
                '--codex-bin', self.bin / 'codex',
                '--brief', self.brief, '--result', self.base / 'result',
                '--run-log', self.base / 'run.log', '--state-dir', self.base / 'lane',
                '--poll-interval', '1', '--startup-timeout', '5']
        if store is not None:
            args += ['--pnpm-store', store]
        return args

    def launch(self, store=None, ok=True):
        return self.call(self.launcher_args(store), ok=ok)

    def test_launcher_pins_store_and_grants_only_resolved_directory(self):
        self.launch(self.store)
        capture = json.loads(Path(self.env['CAPTURE']).read_text())
        expected = str(self.store / 'v11')
        args = capture['args']
        self.assertEqual(args[args.index('--add-dir') + 1], expected)
        self.assertEqual(capture['store'], expected)
        self.assertIn('shell_environment_policy.set.pnpm_config_store_dir=' + json.dumps(expected), args)
        self.assertEqual((self.base / 'lane/pnpm-store').read_text().strip(), expected)
        self.assertEqual((self.base / 'lane/status').read_text().strip(), 'succeeded')
        self.assertFalse((self.repo / '.pnpm-store').exists())

    def test_legacy_pnpm_and_codex_sandbox(self):
        self.env['LEGACY_PNPM'] = '1'
        self.env['OLD_CODEX_SANDBOX'] = '1'
        self.launch(self.store)
        args = json.loads(Path(self.env['CAPTURE']).read_text())['args']
        self.assertIn('shell_environment_policy.set.npm_config_store_dir=' + json.dumps(str(self.store / 'v11')), args)

    def test_default_does_not_add_cache_access(self):
        (self.base / 'lane').mkdir()
        (self.base / 'lane/pnpm-store').write_text('old-store')
        self.launch()
        self.assertFalse((self.base / 'lane/pnpm-store').exists())
        self.assertNotIn('--add-dir', json.loads(Path(self.env['CAPTURE']).read_text())['args'])

    def test_denied_store_fails_before_agent_and_records_terminal_state(self):
        self.env['DENY_STORE'] = '1'
        self.assertNotEqual(self.launch(self.store, ok=False).returncode, 0)
        self.assertFalse(Path(self.env['CAPTURE']).exists())
        self.assertEqual((self.base / 'lane/status').read_text().strip(), 'failed')
        self.assertEqual((self.base / 'lane/exit-code').read_text().strip(), '2')
        self.assertIn('store denied by sandbox', (self.base / 'run.log').read_text())

    def test_cancellation_stops_preflight_children(self):
        pid_file = self.base / 'probe.pid'
        self.env['PROBE_PID'] = str(pid_file)
        process = subprocess.Popen([str(a) for a in self.launcher_args(self.store)],
                                   cwd=self.repo, env=self.env, text=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            deadline = time.monotonic() + 15
            while not pid_file.exists() and time.monotonic() < deadline:
                time.sleep(0.05)
            self.assertTrue(pid_file.exists(), 'sandbox probe did not start')
            process.send_signal(signal.SIGUSR1)
            process.communicate(timeout=15)
            self.assertEqual(process.returncode, 125)
            self.assertEqual((self.base / 'lane/status').read_text().strip(), 'cancelled')
            self.assertFalse(Path(self.env['CAPTURE']).exists())
            pid = int(pid_file.read_text())
            with self.assertRaises(ProcessLookupError):
                os.kill(pid, 0)
        finally:
            if process.poll() is None:
                process.kill()
                process.communicate()
            if pid_file.exists():
                try:
                    os.kill(int(pid_file.read_text()), signal.SIGKILL)
                except ProcessLookupError:
                    pass

    def test_rejects_private_store_and_symlink_to_private_store(self):
        private = self.repo / '.pnpm-store'
        (private / 'v11').mkdir(parents=True)
        alias = self.base / 'alias'
        alias.symlink_to(private, target_is_directory=True)
        for path in [private, alias]:
            with self.subTest(path=path):
                result = self.launch(path, ok=False)
                self.assertIn('separate from worktrees', result.stderr)
                self.assertFalse(Path(self.env['CAPTURE']).exists())

    def test_rejects_fallback_missing_and_relative_store(self):
        for store in [self.base / 'missing', Path('relative')]:
            with self.subTest(store=store):
                self.assertNotEqual(self.launch(store, ok=False).returncode, 0)
        self.env['WRONG_STORE'] = '1'
        self.assertIn('ignored the chosen store', self.launch(self.store, ok=False).stderr)
        self.assertFalse(Path(self.env['CAPTURE']).exists())

    @unittest.skipUnless(shutil.which('tmux'), 'tmux is required for controller integration')
    def test_controller_forwards_store_and_retains_failure_diagnostics(self):
        ctl = ROOT / 'agent-fanout'
        run = 'cache-test'
        self.call([ctl, 'init', '--repo', self.repo, '--sid', run])
        self.addCleanup(lambda: self.call([ctl, 'cleanup', '--run', run, '--drop-worktrees', '--force']))
        self.call([ctl, 'add-lane', '--run', run, '--phase', 'cache'])
        self.call([ctl, 'start', '--run', run, '--phase', 'cache', '--brief', self.brief,
                   '--pnpm-store', self.store])
        self.call([ctl, 'wait', '--run', run, '--phase', 'cache', '--timeout', '30'])
        state = json.loads(self.call([ctl, 'status', '--run', run, '--json']).stdout)
        self.assertEqual(state['lanes'][0]['status'], 'succeeded')
        self.assertEqual(json.loads(Path(self.env['CAPTURE']).read_text())['store'], str(self.store / 'v11'))
        self.call([ctl, 'add-lane', '--run', run, '--phase', 'bad-cache'])
        self.call([ctl, 'start', '--run', run, '--phase', 'bad-cache', '--brief', self.brief,
                   '--pnpm-store', self.base / 'missing'])
        self.call([ctl, 'wait', '--run', run, '--phase', 'bad-cache', '--timeout', '30'], ok=False)
        state = json.loads(self.call([ctl, 'status', '--run', run, '--json']).stdout)
        self.assertEqual(next(x for x in state['lanes'] if x['phase'] == 'bad-cache')['status'], 'failed')
        self.assertNotEqual(self.call([ctl, 'start', '--run', run, '--phase', 'bad-cache',
                                     '--brief', self.brief, '--runner', 'command',
                                     '--pnpm-store', self.store, '--', 'true'], ok=False).returncode, 0)


if __name__ == '__main__':
    unittest.main(verbosity=2)
